OPENAI_API_KEY=replace_with_your_project_api_key
OPENAI_MODEL=gpt-5.6-luna

# Set these instead of the OpenAI variables when using a local Ollama model.
# OLLAMA_MODEL=geometry-local
# OLLAMA_BASE_URL=http://localhost:11434

# Set these when using --provider llama-cpp. The server and model paths are
# required only when this application needs to start llama-server itself.
# LLAMA_CPP_BASE_URL=http://127.0.0.1:8080
# LLAMA_CPP_SERVER_PATH=C:\path\to\llama-server.exe
# LLAMA_CPP_MODEL_PATH=C:\path\to\geometry-model.gguf
